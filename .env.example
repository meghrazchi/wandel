# macOS Code Signing & Notarization (Tauri v2)
# Copy this file to .env (gitignored) for local signed builds,
# and add the same 6 variables as GitHub Actions Repository Secrets for CI releases.
#
# Base64-encoded Developer ID Application .p12 certificate:
#   base64 -i certificate.p12 | pbcopy
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
